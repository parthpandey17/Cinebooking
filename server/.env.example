# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ── MySQL ───────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cinebooker
DB_PASSWORD=cinebooker_pw
DB_NAME=cinebooker
DB_POOL_LIMIT=15
DB_TIMEZONE=Z

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# ── Pricing / locks / waitlist ──────────────────────────
PRICE_PER_SEAT=150
SEAT_LOCK_MS=300000
WAITLIST_OFFER_MS=600000

# ── Razorpay ────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Resend) ──────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FRONTEND_APP_URL=http://localhost:5173

# ── CORS (comma-separated) ──────────────────────────────
FRONTEND_URLS=http://localhost:5173,http://localhost:3000
